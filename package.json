{
  "name": "@voxelkloud/react",
  "version": "0.2.1",
  "description": "React bindings for voxelkloud: <PointCloudViewer/> component and hooks wrapping @voxelkloud/view.",
  "license": "MIT",
  "keywords": [
    "point-cloud",
    "potree",
    "lidar",
    "webgpu",
    "three",
    "threejs",
    "react",
    "viewer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxelkloud/react.git"
  },
  "homepage": "https://github.com/voxelkloud/voxelkloud",
  "bugs": {
    "url": "https://github.com/voxelkloud/voxelkloud/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@voxelkloud/core": "workspace:*",
    "@voxelkloud/loader": "workspace:*",
    "@voxelkloud/view": "workspace:*",
    "@voxelkloud/format-potree": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@types/three": "0.180.0",
    "three": "^0.180.0"
  }
}
